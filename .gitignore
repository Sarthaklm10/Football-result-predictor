# ============================================
# Football Match Predictor — .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
venv/
env/
.venv/

# Jupyter Notebook
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data (processed only — raw CSVs are small enough to track)
data/processed/*.csv
!data/processed/featured_matches.csv

# Trained Models (large binary files)
models/*.joblib
models/*.pkl
# Allow Streamlit app dependencies
!models/best_model.joblib
!models/scaler.joblib
!models/label_encoder.joblib
!models/feature_names.joblib

# Reports (generated outputs)
reports/*.html
reports/*.png

# Environment variables
.env

# Guide (personal viva notes — not part of the project)
guide/

# Distribution / Packaging
dist/
build/
*.egg-info/
